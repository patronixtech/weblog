---
const posts = import.meta.glob('./blog/*.md', { eager: true });
const sorted = Object.entries(posts).sort(([a], [b]) => b.localeCompare(a));
---
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Patronix Technologies</title>
  </head>
  <body>
    <main style="max-width: 760px; margin: 0 auto; padding: 2rem 1.25rem;">
      <header style="margin-bottom: 2rem;">
        <h1>Patronix Technologies</h1>
        <p style="color:#555;">Daily tech news brief.</p>
      </header>

      <section style="margin-top:2rem;">
        <h2>Daily Tech Brief</h2>
        {sorted.length === 0 && <p>No briefs yet.</p>}
        <ul style="list-style:none; padding:0; margin:0.5rem 0 0 0; display:flex; flex-direction:column; gap:0.5rem;">
          {sorted.map(([rawPath, post]) => {
            const slug = rawPath.replace('./blog/', '').replace(/\.md$/, '');
            const date = post.matter?.date ?? '';
            const label = date ? new Date(date).toDateString() : slug;
            return (
              <li style="border-top:1px solid #eee; padding-top:0.75rem;">
                <a href={`/${slug}`} style="font-weight:600;">{label}</a>
              </li>
            );
          })}
        </ul>
      </section>
    </main>
  </body>
</html>
