---
const posts = import.meta.glob('./blog/*.md', { eager: true });
const sorted = Object.entries(posts).sort(([a], [b]) => b.localeCompare(a));
---
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Patronix Technologies</title>
  </head>
  <body>
    <main style="max-width: 760px; margin: 0 auto; padding: 2rem 1.25rem;">
      <header style="margin-bottom: 2rem;">
        <h1>Patronix Technologies</h1>
        <p style="color:#555;">Daily tech news brief.</p>
      </header>

      <section>
        <h2>Latest posts</h2>
        {sorted.length === 0 && <p>No posts yet.</p>}
        {sorted.map(([rawPath, post]) => {
          const slug = rawPath.replace('./blog/', '').replace(/\.md$/, '');
          const title = post.matter?.title ?? 'Untitled';
          const date = post.matter?.date ?? '';
          return (
            <article style="border-top:1px solid #eee; padding-top:0.75rem; margin-top:0.75rem;">
              <h3><a href={`/${slug}`}>{title}</a></h3>
              {date && <div style="color:#777; font-size:0.85rem;">{new Date(date).toDateString()}</div>}
            </article>
          );
        })}
      </section>
    </main>
  </body>
</html>
