---
const posts = Object.entries(import.meta.glob('./blog/*.md', { eager: true }))
  .filter(([, post]) => post.frontmatter?.title)
  .sort(([a], [b]) => b.localeCompare(a))
  .slice(0, 3);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="PatronixTech builds practical AI, product, and software experiences for modern teams." />
    <title>PatronixTech | AI, software, and product strategy</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="hero">
        <div class="hero-copy">
          <p class="eyebrow">PatronixTech</p>
          <h1>Practical AI and software thinking for ambitious teams.</h1>
          <p class="lead">
            We help founders, operators, and builders turn emerging technology into clear products,
            usable workflows, and measurable momentum.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="/blog">Read the daily brief</a>
            <a class="btn btn-secondary" href="mailto:hello@patronixtech.com">Contact us</a>
          </div>
        </div>
        <div class="hero-card">
          <h2>What we focus on</h2>
          <ul>
            <li>AI product strategy and implementation</li>
            <li>Modern web and software experiences</li>
            <li>Clear communication for technical ideas</li>
          </ul>
        </div>
      </header>

      <main class="content-grid">
        <section class="card">
          <p class="eyebrow">About PatronixTech</p>
          <h2>We make complex technology feel simple and useful.</h2>
          <p>
            PatronixTech combines product thinking, software craft, and a sharp eye for AI trends to help
            teams move faster without losing clarity.
          </p>
        </section>

        <section class="card">
          <p class="eyebrow">Latest briefings</p>
          <div class="post-list">
            {posts.length === 0 ? (
              <p class="muted">New briefs will appear here soon.</p>
            ) : (
              posts.map(([rawPath, post]) => {
                const slug = rawPath.replace('./blog/', '').replace(/\.md$/, '');
                const date = post.frontmatter?.date ?? '';
                const title = post.frontmatter?.title ?? 'Daily Tech Brief';
                const formattedDate = date
                  ? new Date(date).toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' })
                  : slug;

                return (
                  <a class="post-item" href={`/briefs/${slug}`}>
                    <span class="post-date">{formattedDate}</span>
                    <strong>{title}</strong>
                  </a>
                );
              })
            )}
          </div>
          <a class="text-link" href="/blog">View all posts →</a>
        </section>
      </main>
    </div>

    <style is:global>
      :root {
        color-scheme: dark;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #07111f;
        color: #f7f9fc;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #020617 0%, #07111f 45%, #10213a 100%);
        color: #f7f9fc;
      }
      a { color: inherit; text-decoration: none; }
      .page-shell {
        max-width: 1120px;
        margin: 0 auto;
        padding: 24px 20px 48px;
      }
      .hero {
        display: grid;
        gap: 24px;
        grid-template-columns: 1.5fr 0.9fr;
        align-items: center;
        padding: 48px 0 28px;
      }
      .eyebrow {
        margin: 0 0 10px;
        text-transform: uppercase;
        letter-spacing: 0.24em;
        font-size: 0.78rem;
        color: #74d4ff;
        font-weight: 700;
      }
      h1, h2, h3 { line-height: 1.1; margin: 0; }
      .hero h1 {
        font-size: clamp(2.2rem, 4.2vw, 3.3rem);
        max-width: 740px;
      }
      .lead {
        font-size: 1.05rem;
        max-width: 660px;
        margin: 16px 0 0;
        color: #c8d2e2;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 24px;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 12px 18px;
        font-weight: 700;
        transition: transform 160ms ease, background 160ms ease;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary {
        background: linear-gradient(135deg, #3b82f6, #14b8a6);
        color: white;
      }
      .btn-secondary {
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.04);
      }
      .hero-card, .card {
        background: rgba(7, 15, 28, 0.8);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.22);
        backdrop-filter: blur(16px);
      }
      .hero-card ul {
        margin: 12px 0 0;
        padding-left: 18px;
        color: #d7e0ec;
        display: grid;
        gap: 8px;
      }
      .content-grid {
        display: grid;
        gap: 20px;
        grid-template-columns: 1fr 1fr;
      }
      .card h2 { font-size: 1.5rem; margin-bottom: 10px; }
      .card p { color: #d7e0ec; line-height: 1.7; }
      .post-list { display: grid; gap: 10px; margin-top: 12px; }
      .post-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 12px 0;
        border-top: 1px solid rgba(255,255,255,0.08);
      }
      .post-date {
        color: #74d4ff;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
      }
      .muted { color: #c8d2e2; }
      .text-link { display: inline-block; margin-top: 8px; font-weight: 700; color: #74d4ff; }
      @media (max-width: 820px) {
        .hero, .content-grid { grid-template-columns: 1fr; }
      }
      @media (max-width: 720px) {
        .page-shell { padding: 18px 14px 36px; }
        .hero { padding-top: 24px; }
        .hero-card, .card { padding: 18px; }
      }
    </style>
  </body>
</html>
