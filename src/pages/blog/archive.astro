---
const posts = Object.entries(import.meta.glob('../blog/*.md', { eager: true }))
  .filter(([, post]) => post.frontmatter?.title)
  .map(([rawPath, post]) => {
    const slug = rawPath.replace('../blog/', '').replace(/\.md$/, '');
    const date = post.frontmatter?.date ?? '';
    const time = date ? new Date(date).getTime() : 0;
    return {
      slug,
      title: post.frontmatter?.title ?? 'Daily Tech Brief',
      date,
      time,
    };
  })
  .sort((a, b) => b.time - a.time || b.slug.localeCompare(a.slug));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Archive of PatronixTech daily tech and AI briefs by date." />
    <title>Archive | PatronixTech</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="hero compact">
        <p class="eyebrow">PatronixTech Archive</p>
        <h1>All daily briefs by date.</h1>
        <p class="lead">Browse every published briefing in reverse chronological order.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/blog">Back to journal</a>
          <a class="btn btn-secondary" href="/">Back to home</a>
        </div>
      </header>

      <main class="content">
        <section class="card">
          <div class="section-heading">
            <p class="eyebrow">Archive</p>
            <h2>Past news and briefings</h2>
          </div>

          <div class="post-list">
            {posts.map((post) => {
              const formattedDate = post.date
                ? new Date(post.date).toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' })
                : post.slug;
              return (
                <a class="post-card" href={`/briefs/${post.slug}`}>
                  <p class="post-date">{formattedDate}</p>
                  <h3>{post.title}</h3>
                </a>
              );
            })}
          </div>
        </section>
      </main>
    </div>

    <style is:global>
      :root {
        color-scheme: dark;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #07111f;
        color: #f7f9fc;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #030712 0%, #07111f 45%, #10213a 100%);
        color: #f7f9fc;
      }
      a { color: inherit; text-decoration: none; }
      .page-shell {
        max-width: 1000px;
        margin: 0 auto;
        padding: 24px 20px 48px;
      }
      .hero {
        padding: 56px 0 28px;
      }
      .eyebrow {
        margin: 0 0 8px;
        text-transform: uppercase;
        letter-spacing: 0.24em;
        font-size: 0.78rem;
        color: #74d4ff;
        font-weight: 700;
      }
      h1, h2, h3 { line-height: 1.1; margin: 0; }
      .hero h1 { font-size: clamp(2rem, 4vw, 2.8rem); }
      .lead {
        font-size: 1.05rem;
        max-width: 680px;
        margin: 16px 0 0;
        color: #c8d2e2;
      }
      .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 18px;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 12px 18px;
        font-weight: 700;
        transition: transform 160ms ease, background 160ms ease;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary {
        background: linear-gradient(135deg, #3b82f6, #14b8a6);
        color: white;
      }
      .btn-secondary {
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.04);
      }
      .content { display: grid; gap: 20px; }
      .card {
        background: rgba(7, 15, 28, 0.8);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.22);
        backdrop-filter: blur(16px);
      }
      .section-heading { margin-bottom: 16px; }
      .section-heading h2 { font-size: 1.5rem; }
      .post-list { display: grid; gap: 12px; }
      .post-card {
        display: block;
        padding: 16px 18px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        transition: transform 160ms ease, border-color 160ms ease;
      }
      .post-card:hover {
        transform: translateY(-2px);
        border-color: rgba(116, 212, 255, 0.5);
      }
      .post-date {
        margin: 0 0 8px;
        color: #74d4ff;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
      }
      .post-card h3 { font-size: 1.05rem; }
      @media (max-width: 720px) {
        .page-shell { padding: 18px 14px 36px; }
        .card { padding: 18px; }
      }
    </style>
  </body>
</html>
