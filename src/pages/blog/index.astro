---
import { formatDate, getSortTime } from '../../utils/date';

const posts = Object.entries(import.meta.glob('./*.md', { eager: true }))
  .filter(([, post]) => post.frontmatter?.title)
  .map(([rawPath, post]) => ({
    rawPath,
    post,
    time: getSortTime(post.frontmatter?.date ?? ''),
  }))
  .sort((a, b) => b.time - a.time || b.rawPath.localeCompare(a.rawPath));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Daily tech and AI briefings from PatronixTech." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Blog | PatronixTech</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="hero compact">
        <div class="brand-row">
          <img class="brand-mark" src="/patronix-logo.svg" alt="PatronixTech logo" />
          <p class="eyebrow">PatronixTech Journal</p>
        </div>
        <h1>Daily technology and AI news, distilled.</h1>
        <p class="lead">Short, useful updates designed for founders, builders, and curious readers who want the signal without the noise.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/">Back to home</a>
          <span class="subtle">Fresh updates every day</span>
        </div>
      </header>

      <main class="content">
        <section class="card highlight-card">
          <div class="highlight-copy">
            <p class="eyebrow">Why this exists</p>
            <h2>We collect the most relevant AI and product shifts into short, readable briefs.</h2>
          </div>
          <div class="highlight-meta">
            <div><strong>Signal over noise</strong><span>Concise rundowns with context</span></div>
            <div><strong>Built for speed</strong><span>Fast scanning on any device</span></div>
          </div>
        </section>

        <section class="card">
          <div class="section-heading">
            <p class="eyebrow">Latest briefs</p>
            <h2>Fresh updates from the world of AI and software</h2>
          </div>

          {posts.length === 0 ? (
            <p class="empty">No briefs published yet.</p>
          ) : (
            <div class="post-list">
              {posts.map(({ rawPath, post }) => {
                const slug = rawPath.replace('./', '').replace(/\.md$/, '');
                const date = post.frontmatter?.date ?? '';
                const title = post.frontmatter?.title ?? 'Daily Tech Brief';
                const formattedDate = date ? formatDate(date) : slug;

                return (
                  <a class="post-card" href={`/briefs/${slug}`}>
                    <p class="post-date">{formattedDate}</p>
                    <h3>{title}</h3>
                    <p>{post.frontmatter?.description ?? 'A concise roundup of the day’s most relevant technology and AI stories.'}</p>
                  </a>
                );
              })}
            </div>
          )}
        </section>
      </main>
    </div>

    <style is:global>
      :root {
        color-scheme: dark;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #07111f;
        color: #f7f9fc;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #030712 0%, #07111f 45%, #10213a 100%);
        color: #f7f9fc;
      }

      a { color: inherit; text-decoration: none; }
      .page-shell {
        max-width: 1120px;
        margin: 0 auto;
        padding: 24px 20px 48px;
      }
      .hero {
        padding: 56px 0 36px;
      }
      .hero.compact { padding-bottom: 20px; }
      .brand-row {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
      }
      .brand-mark {
        width: 40px;
        height: 40px;
        border-radius: 13px;
      }
      .eyebrow {
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.24em;
        font-size: 0.78rem;
        color: #74d4ff;
        font-weight: 700;
      }
      h1, h2, h3 { line-height: 1.1; margin: 0; }
      .hero h1 {
        font-size: clamp(2.1rem, 4vw, 3.2rem);
        max-width: 760px;
      }
      .lead {
        font-size: 1.05rem;
        max-width: 680px;
        margin: 16px 0 0;
        color: #c8d2e2;
      }
      .hero-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 18px;
      }
      .subtle {
        color: #9eb0c8;
        font-size: 0.95rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 12px 18px;
        font-weight: 700;
        transition: transform 160ms ease, background 160ms ease;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary {
        background: linear-gradient(135deg, #3b82f6, #14b8a6);
        color: white;
      }
      .content { display: grid; gap: 20px; }
      .card {
        background: rgba(7, 15, 28, 0.8);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.22);
        backdrop-filter: blur(16px);
      }
      .highlight-card {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 20px;
        align-items: center;
      }
      .highlight-copy h2 { font-size: 1.35rem; margin-top: 6px; }
      .highlight-meta { display: grid; gap: 10px; }
      .highlight-meta div {
        padding: 12px 14px;
        border-radius: 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
      }
      .highlight-meta strong { display: block; margin-bottom: 4px; }
      .highlight-meta span { color: #c8d2e2; font-size: 0.92rem; }
      .section-heading { margin-bottom: 16px; }
      .section-heading h2 { font-size: 1.5rem; }
      .post-list { display: grid; gap: 14px; }
      .post-card {
        display: block;
        padding: 18px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        transition: transform 160ms ease, border-color 160ms ease;
      }
      .post-card:hover {
        transform: translateY(-2px);
        border-color: rgba(116, 212, 255, 0.5);
      }
      .post-date {
        margin: 0 0 8px;
        color: #74d4ff;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
      }
      .post-card h3 { font-size: 1.1rem; margin-bottom: 8px; }
      .post-card p { margin: 0; color: #c8d2e2; }
      .empty { color: #c8d2e2; }
      @media (max-width: 820px) {
        .highlight-card { grid-template-columns: 1fr; }
      }
      @media (max-width: 720px) {
        .page-shell { padding: 18px 14px 36px; }
        .card { padding: 18px; }
      }
    </style>
  </body>
</html>
