---
export async function getStaticPaths() {
  const posts = await import.meta.glob('../blog/*.md', { eager: true });
  return Object.entries(posts)
    .filter(([, post]) => post.frontmatter?.title)
    .map(([path, post]) => {
      const slug = path.split('/').pop()?.replace(/\.md$/, '') ?? '';
      return {
        params: { slug },
        props: { post, slug },
      };
    });
}

const { post, slug } = Astro.props;
const { Content } = post;
const title = post.frontmatter?.title ?? 'Daily Tech Brief';
const date = post.frontmatter?.date ?? '';
const formattedDate = date
  ? new Date(date).toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' })
  : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`PatronixTech briefing: ${title}`} />
    <title>{title} | PatronixTech</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="hero compact">
        <p class="eyebrow">PatronixTech Journal</p>
        <h1>{title}</h1>
        {formattedDate && <p class="lead">{formattedDate}</p>}
        <div class="hero-actions">
          <a class="btn btn-primary" href="/blog">View all briefs</a>
          <span class="subtle">A concise briefing for modern teams</span>
        </div>
      </header>

      <main class="content">
        <article class="card article-card">
          <Content />
        </article>
      </main>
    </div>

    <style is:global>
      :root {
        color-scheme: dark;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #07111f;
        color: #f7f9fc;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #030712 0%, #07111f 45%, #10213a 100%);
        color: #f7f9fc;
      }
      a { color: inherit; text-decoration: none; }
      .page-shell {
        max-width: 900px;
        margin: 0 auto;
        padding: 24px 20px 48px;
      }
      .hero {
        padding: 56px 0 24px;
      }
      .hero-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 18px;
      }
      .subtle {
        color: #9eb0c8;
        font-size: 0.95rem;
      }
      .eyebrow {
        margin: 0 0 10px;
        text-transform: uppercase;
        letter-spacing: 0.24em;
        font-size: 0.78rem;
        color: #74d4ff;
        font-weight: 700;
      }
      h1, h2, h3 { line-height: 1.1; margin: 0; }
      .hero h1 { font-size: clamp(2rem, 4vw, 2.8rem); }
      .lead {
        font-size: 1.02rem;
        margin: 12px 0 0;
        color: #c8d2e2;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 12px 18px;
        font-weight: 700;
        transition: transform 160ms ease, background 160ms ease;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary {
        background: linear-gradient(135deg, #3b82f6, #14b8a6);
        color: white;
        margin-top: 20px;
      }
      .card {
        background: rgba(7, 15, 28, 0.8);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.22);
        backdrop-filter: blur(16px);
      }
      .article-card {
        max-width: 760px;
        margin: 0 auto;
      }
      .article-card :global(h2) {
        font-size: 1.25rem;
        margin-top: 1.2rem;
        margin-bottom: 0.65rem;
      }
      .article-card :global(p) {
        color: #d7e0ec;
        line-height: 1.8;
        font-size: 1.02rem;
      }
      .article-card :global(ol), .article-card :global(ul) {
        padding-left: 1.2rem;
        color: #d7e0ec;
        line-height: 1.7;
      }
      .article-card :global(li) { margin-bottom: 0.55rem; }
      .article-card :global(strong) { color: #ffffff; }
      @media (max-width: 720px) {
        .page-shell { padding: 18px 14px 36px; }
        .card { padding: 18px; }
      }
    </style>
  </body>
</html>
